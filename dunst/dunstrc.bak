[global]
    monitor = 0
    follow = mouse
    width = (250, 350)
    height = (0, 200)
    origin = top-right
    offset = (12, 48)
    gap_size = 8
    padding = 12
    horizontal_padding = 14
    frame_width = 1
    corner_radius = 10
    separator_height = 0

    font = JetBrainsMono Nerd Font 11
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    word_wrap = yes

    icon_position = left
    max_icon_size = 48
    enable_recursive_icon_lookup = true

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa"
    timeout = 5

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#b4befe"
    timeout = 8

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#f38ba8"
    timeout = 0
